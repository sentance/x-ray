# Optional: enables "Ask AI" (strategy explanation + chat)
OPENAI_API_KEY=
# Model used for the explanation and chat (gpt-5.6-terra is sharper, about 10x the cost)
XRAY_AI_MODEL=gpt-5.6-luna
# Hourly caps on AI requests (explanations + chat answers): per visitor, and across everyone
XRAY_AI_PER_IP_PER_HOUR=20
XRAY_AI_PER_HOUR=200
